# Copy to .env (or paste into Compose Manager's "Edit ENV") and fill in.
INVITE_CODE=change-me
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=2048
# FCM_SERVICE_ACCOUNT=/data/firebase-service-account.json
# Free key from developers.giphy.com, for GIF search
# GIPHY_API_KEY=
# GIF_RATING=r
# Calls: a long random secret (openssl rand -hex 32) and the hostname that points at your home IP
TURN_SECRET=
TURN_HOST=turn.example.com

# Nightly encrypted backups (database + photos/videos/files) into /mnt/user/backups/bants.
# Use a long passphrase and store it in a password manager: without it, backups can't be restored.
BACKUP_PASSPHRASE=
# How many nightly database snapshots to keep, and the hour (0-23) they run.
BACKUP_KEEP=14
BACKUP_HOUR=3
